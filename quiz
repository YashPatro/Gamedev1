x = 355
y = 86
import os
os.environ['SDL_VIDEO_WINDOW_POS'] = f'{x},{y}'


import pgzrun

TITLE = 'QUIZ'

HEIGHT = 575
WIDTH = 800

q_file = 'questions.txt'
q_append = []

score = 0 
current_que = 0 
question_count = 0
scroll_msg = ''
t_time = 10
g_over = False

scroller_box = Rect(0,0,800,100)

quiz_box = Rect(25,145,550,100)

ans1 = Rect(25,290,250,100)
ans2 = Rect(325,290,250,100)
ans3 = Rect(25,435,250,100)
ans4 = Rect(325,435,250,100)

ans = [ans1,ans2,ans3,ans4]

skip_box = Rect(600,290,150,245)

time_box = Rect(600,145,150,100)

def draw():
    global scroll_msg

    screen.clear()
    screen.fill('black')
    screen.draw.filled_rect(scroller_box,'light yellow')
    screen.draw.filled_rect(quiz_box,'red')
    screen.draw.filled_rect(skip_box,'green')
    screen.draw.filled_rect(time_box,'sky blue')
    for i in ans:
        screen.draw.filled_rect(i,'light grey')
    
    scroll_msg = f'Welcome to the quiz, you are on Q:{current_que} of {question_count}'
    screen.draw.textbox(scroll_msg, scroller_box, color='black')
    screen.draw.textbox(str(t_time), time_box, color = 'dark blue')
    screen.draw.textbox('skip', skip_box, color = 'dark green', angle = -90)

    for i in question:
        screen.draw.textbox(question[0], quiz_box, color='black')
        screen.draw.textbox(question[1],ans1,color = 'black')
        screen.draw.textbox(question[2],ans2,color = 'black')
        screen.draw.textbox(question[3],ans3,color = 'black')
        screen.draw.textbox(question[4],ans4,color = 'black')

def update():
    scroller_box.x-=2
    if scroller_box.x==-800:
        scroller_box.x=800

def read_q():
    global    question_count

    with open(q_file,'r') as f:
        for i in f:
            q_append.append(i)
            question_count+=1

def read_nq():
    global current_que
    current_que+=1

    return q_append.pop(0).split('|')

#31/08/24
def skip_q():
    global question,t_time
    if g_over==False and q_append:
        question = read_nq()
        t_time = 10
    else:
        game_over()

def correct_ans():
    global question,t_time,q_append,score

    score+=1
    if q_append:
        question = read_nq()
        t_time=10
    else:
        game_over()

def game_over():
    global t_time,g_over,question
    message = f'Gameover! You got {score} questions correct!'
    question = [message,'-','-','-','-',5]
    t_time = 0
    g_over = True

def on_mouse_down(pos):
    index = 1
    for i in ans:
        if i.collidepoint(pos):
            if index is int(question[5]):
                correct_ans()
            else:
                game_over()

        index+=1
    if skip_box.collidepoint(pos):
        skip_q()


def timer():
    global t_time
    if t_time:
        t_time-=1

    else:
        game_over()

read_q()
question = read_nq()
clock.schedule_interval(timer,1)

pgzrun.go()

    
